async function rechercherColis() {
    const input = document.getElementById('trackingInput');
    const zoneResultat = document.getElementById('resultat');

    if (!input || !input.value.trim()) {
        alert("Veuillez entrer un numéro de suivi.");
        return;
    }

    const code = input.value.trim();

    try {
        // Envoi de la requête au serveur Node.js
        const response = await fetch(`/api/suivi/${code}`);
        const data = await response.json();

        if (data.succes) {
            zoneResultat.style.color = "green";
            zoneResultat.innerHTML = `
                <div style="text-align: left; background: #fff; padding: 15px; border-radius: 8px; margin-top: 15px; border: 1px solid #ddd;">
                    <p><strong>Colis :</strong> ${data.colis.numero}</p>
                    <p><strong>Statut :</strong> ${data.colis.statut}</p>
                    <p><strong>Client :</strong> ${data.colis.client}</p>
                    <p><strong>Origine :</strong> ${data.colis.origine}</p>
                    <p><strong>Destination :</strong> ${data.colis.destination}</p>
                    <p><strong>Estimation (ETA) :</strong> ${data.colis.eta}</p>
                </div>
            `;
        } else {
            zoneResultat.style.color = "red";
            zoneResultat.innerHTML = `<p style="margin-top: 15px;">${data.message}</p>`;
        }
    } catch (error) {
        console.error("Erreur de connexion au serveur :", error);
        zoneResultat.style.color = "red";
        zoneResultat.innerHTML = "<p style="margin-top: 15px;">Erreur de communication avec le serveur.</p>";
    }
}
