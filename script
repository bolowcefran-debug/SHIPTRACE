// Définissez la date et l'heure exactes de livraison prévue
const targetTime = new Date("October 18, 2026 18:00:00").getTime();

const updateCountdown = setInterval(() => {
  const now = new Date().getTime();
  const timeLeft = targetTime - now;

  const countdownElement = document.getElementById("live-countdown");

  if (!countdownElement) return;

  if (timeLeft < 0) {
    clearInterval(updateCountdown);
    countdownElement.innerHTML = "Délai dépassé / Livraison imminente";
    countdownElement.className = "text-lg font-bold text-red-600";
    return;
  }

  // Calcul des jours, heures, minutes et secondes restants
  const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
  const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
  const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

  // Affichage formaté dans la zone dédiée
  countdownElement.innerHTML = `${days}j ${hours}h ${minutes}m ${seconds}s`;

