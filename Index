        function switchLanguage(lang) {
            currentLang = lang;
            document.documentElement.lang = lang;
            const elements = document.querySelectorAll('[data-i18n]');
            elements.forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });
        }

        let isAdminLoggedIn = false;

        const defaultParcel = {
            tracking: "TRK-2026-88942",
            clientName: "Jean Dupont",
            clientPhone: "+33 6 12 34 56 78",
            address: "124 Avenue des Champs-Élysées, Paris",
            type: "Fragile Electronic Equipment",
            dimensions: "4.5 kg - 35x25x15 cm",
            origin: "Lyon Logistics Hub (Zone A)",
            destination: "Paris Centre (Zone 7)",
            eta: "24 to 48 Hours (Expected: 18 Oct. 2026)",
            notes: "Fragile - Handle with care. Signature required upon delivery."
        };

        function getParcels() {
            let data = localStorage.getItem('shiptrace_multi_parcels');
            if (!data) {
                let initial = { "TRK-2026-88942": defaultParcel };
                localStorage.setItem('shiptrace_multi_parcels', JSON.stringify(initial));
                return initial;
            }
            return JSON.parse(data);
        }

        function toggleAdminMode() {
            if (!isAdminLoggedIn) {
                document.getElementById('login-section').classList.toggle('hidden');
            } else {
                isAdminLoggedIn = false;
                document.getElementById('admin-panel').classList.add('hidden');
                document.getElementById('admin-toggle-btn').innerHTML = `<i class="fa-solid fa-lock"></i> <span data-i18n="admin_btn">${translations[currentLang].admin_btn}</span>`;
                alert(currentLang === 'fr' ? "Déconnecté de l'espace administrateur." : (currentLang === 'es' ? "Sesión de administrador cerrada." : "Logged out of admin area."));
            }
        }

        function loginAdmin(e) {
            e.preventDefault();
            let email = document.getElementById('admin-email').value;
            let pass = document.getElementById('admin-password').value;

            if (email === "bolowcefran@gmail.com" && pass === "nolhanyvan237") {
                isAdminLoggedIn = true;
                document.getElementById('login-section').classList.add('hidden');
                document.getElementById('admin-panel').classList.remove('hidden');
                document.getElementById('admin-toggle-btn').innerHTML = `<i class="fa-solid fa-right-from-bracket"></i> ${currentLang === 'fr' ? 'Déconnexion' : (currentLang === 'es' ? 'Cerrar Sesión' : 'Logout')}`;
                updateAdminList();
                alert(currentLang === 'fr' ? "Connexion Administrateur réussie !" : (currentLang === 'es' ? "¡Inicio de sesión de administrador exitoso!" : "Admin login successful!"));
            } else {
                alert(currentLang === 'fr' ? "Identifiant ou mot de passe incorrect." : (currentLang === 'es' ? "Identidad o contraseña incorrecta." : "Incorrect ID or password."));
            }
        }

        function saveParcel(e) {
            e.preventDefault();
            if (!isAdminLoggedIn) return;

            let trackingCode = document.getElementById('p-tracking').value.trim().toUpperCase();
            let p = {
                tracking: trackingCode,
                clientName: document.getElementById('p-client-name').value,
                clientPhone: document.getElementById('p-client-phone').value,
                address: document.getElementById('p-address').value,
                type: document.getElementById('p-type').value,
                dimensions: document.getElementById('p-dimensions').value,
                origin: document.getElementById('p-origin').value,
                destination: document.getElementById('p-destination').value,
                eta: document.getElementById('p-eta').value,
                notes: document.getElementById('p-notes').value
            };

            let parcels = getParcels();
            parcels[trackingCode] = p; // Enregistre ou met à jour ce code spécifique
            localStorage.setItem('shiptrace_multi_parcels', JSON.stringify(parcels));

            displayParcel(p);
            updateAdminList();
            alert(currentLang === 'fr' ? "Colis enregistré avec succès !" : (currentLang === 'es' ? "¡Paquete guardado con éxito!" : "Parcel saved successfully!"));
        }

        function searchParcel() {
            let code = document.getElementById('search-input').value.trim().toUpperCase();
            let parcels = getParcels();
            let err = document.getElementById('search-error');

            if (parcels[code]) {
                err.classList.add('hidden');
                displayParcel(parcels[code]);
            } else {
                err.classList.remove('hidden');
            }
        }

        function displayParcel(p) {
            document.getElementById('receipt-tracking').innerText = p.tracking;
            document.getElementById('r-client-name').innerText = p.clientName;
            document.getElementById('r-client-phone').innerText = p.clientPhone;
            document.getElementById('r-address').innerText = p.address;
            document.getElementById('r-type').innerText = p.type;
            document.getElementById('r-dimensions').innerText = p.dimensions;
            document.getElementById('r-origin').innerText = p.origin;
            document.getElementById('r-destination').innerText = p.destination;
            document.getElementById('r-eta').innerText = p.eta;
            document.getElementById('r-notes').innerText = p.notes;
        }

        function addNewParcelForm() {
            document.getElementById('p-tracking').value = "TRK-2026-" + Math.floor(10000 + Math.random() * 90000);
            document.getElementById('p-client-name').value = "";
            document.getElementById('p-client-phone').value = "";
            document.getElementById('p-address').value = "";
            document.getElementById('p-type').value = "";
            document.getElementById('p-dimensions').value = "";
            document.getElementById('p-origin').value = "";
            document.getElementById('p-destination').value = "";
            document.getElementById('p-eta').value = "";
            document.getElementById('p-notes').value = "";
        }

        function updateAdminList() {
            let parcels = getParcels();
            let list = document.getElementById('admin-parcels-list');
            list.innerHTML = '';
            for (let code in parcels) {
                let div = document.createElement('div');
                div.className = "flex justify-between items-center bg-slate-50 hover:bg-slate-100 p-2 rounded border border-slate-200 cursor-pointer";
                div.innerHTML = `<span class="font-mono font-bold text-blue-600">${code}</span> <span class="text-slate-600">${parcels[code].clientName}</span>`;
                div.onclick = () => {
                    displayParcel(parcels[code]);
                    document.getElementById('p-tracking').value = parcels[code].tracking;
                    document.getElementById('p-client-name').value = parcels[code].clientName;
                    document.getElementById('p-client-phone').value = parcels[code].clientPhone;
                    document.getElementById('p-address').value = parcels[code].address;
                    document.getElementById('p-type').value = parcels[code].type;
                    document.getElementById('p-dimensions').value = parcels[code].dimensions;
                    document.getElementById('p-origin').value = parcels[code].origin;
                    document.getElementById('p-destination').value = parcels[code].destination;
                    document.getElementById('p-eta').value = parcels[code].eta;
                    document.getElementById('p-notes').value = parcels[code].notes;
                };
                list.appendChild(div);
            }
        }

        function generateShareLink() {
            let tracking = document.getElementById('p-tracking').value;
            let url = window.location.origin + window.location.pathname + "?tracking=" + tracking;
            navigator.clipboard.writeText(url);
            alert(currentLang === 'fr' ? "Lien direct copié dans le presse-papier !\n\n" + url : (currentLang === 'es' ? "¡Enlace directo copiado al portapapeles!\n\n" + url : "Direct link copied to clipboard!\n\n" + url));
        }

        window.onload = function() {
            let parcels = getParcels();
            updateAdminList();
            const urlParams = new URLSearchParams(window.location.search);
            const trackingParam = urlParams.get('tracking');
            if (trackingParam && parcels[trackingParam]) {
                document.getElementById('search-input').value = trackingParam;
                displayParcel(parcels[trackingParam]);
            } else {
                displayParcel(defaultParcel);
            }
        };
    </script>
